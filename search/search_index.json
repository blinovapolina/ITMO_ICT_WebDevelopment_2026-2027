0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f. \u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0441\u044b\u043b\u0430\u0435\u0442 \u0434\u0430\u0442\u0430\u0433\u0440\u0430\u043c\u043c\u0443, \u043d\u0435 \u0434\u043e\u0436\u0438\u0434\u0430\u044f\u0441\u044c \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u043e\u0442 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u0435\u043b\u044f.</p> \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430 UDP \u0421\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u041d\u0435 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0413\u0430\u0440\u0430\u043d\u0442\u0438\u044f \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u041d\u0435\u0442 \u041f\u043e\u0440\u044f\u0434\u043e\u043a \u043f\u0430\u043a\u0435\u0442\u043e\u0432 \u041d\u0435 \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0412\u044b\u0441\u043e\u043a\u0430\u044f \u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0412\u0438\u0434\u0435\u043e, \u0438\u0433\u0440\u044b, DNS, \u0441\u0442\u0440\u0438\u043c\u0438\u043d\u0433"},{"location":"lr1/report/#_6","title":"\u0424\u0430\u0439\u043b\u044b","text":"<ul> <li><code>part_1_udp/udp_server.py</code> \u2014 \u0441\u0435\u0440\u0432\u0435\u0440</li> <li><code>part_1_udp/udp_client.py</code> \u2014 \u043a\u043b\u0438\u0435\u043d\u0442</li> </ul>"},{"location":"lr1/report/#_7","title":"\u041b\u043e\u0433\u0438\u043a\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0430","text":"<ol> <li>\u0421\u043e\u0437\u0434\u0430\u0442\u044c UDP-\u0441\u043e\u043a\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 <code>socket.socket(AF_INET, SOCK_DGRAM)</code></li> <li>\u041f\u0440\u0438\u0432\u044f\u0437\u0430\u0442\u044c \u043a <code>localhost:12345</code> \u0447\u0435\u0440\u0435\u0437 <code>bind()</code></li> <li>\u0412 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c \u0446\u0438\u043a\u043b\u0435 \u0432\u044b\u0437\u044b\u0432\u0430\u0442\u044c <code>recvfrom(1024)</code> \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0434\u0430\u0442\u0430\u0433\u0440\u0430\u043c\u043c\u044b</li> <li>\u0412\u044b\u0432\u0435\u0441\u0442\u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0432 \u043a\u043e\u043d\u0441\u043e\u043b\u044c</li> <li>\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043e\u0442\u0432\u0435\u0442 <code>\"Hello, client\"</code> \u0447\u0435\u0440\u0435\u0437 <code>sendto()</code> \u043d\u0430 \u0430\u0434\u0440\u0435\u0441 \u043a\u043b\u0438\u0435\u043d\u0442\u0430</li> </ol>"},{"location":"lr1/report/#_8","title":"\u041b\u043e\u0433\u0438\u043a\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430","text":"<ol> <li>\u0421\u043e\u0437\u0434\u0430\u0442\u044c UDP-\u0441\u043e\u043a\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 <code>socket.socket(AF_INET, SOCK_DGRAM)</code></li> <li>\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c <code>\"Hello, server\"</code> \u0447\u0435\u0440\u0435\u0437 <code>sendto()</code> \u043d\u0430 \u0430\u0434\u0440\u0435\u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u0430</li> <li>\u0414\u043e\u0436\u0434\u0430\u0442\u044c\u0441\u044f \u043e\u0442\u0432\u0435\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 <code>recvfrom(1024)</code></li> <li>\u0412\u044b\u0432\u0435\u0441\u0442\u0438 \u043e\u0442\u0432\u0435\u0442 \u0432 \u043a\u043e\u043d\u0441\u043e\u043b\u044c</li> <li>\u0417\u0430\u043a\u0440\u044b\u0442\u044c \u0441\u043e\u043a\u0435\u0442</li> </ol>"},{"location":"lr1/report/#_9","title":"\u041f\u0440\u0438\u043c\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u044b","text":""},{"location":"lr1/report/#2-tcp","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u0435 2. \u0412\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0447\u0435\u0440\u0435\u0437 TCP","text":""},{"location":"lr1/report/#_10","title":"\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430","text":"<p>TCP (Transmission Control Protocol) \u2014 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b \u0441 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f. \u041f\u0435\u0440\u0435\u0434 \u043e\u0431\u043c\u0435\u043d\u043e\u043c \u0434\u0430\u043d\u043d\u044b\u043c\u0438 \u043a\u043b\u0438\u0435\u043d\u0442 \u0438 \u0441\u0435\u0440\u0432\u0435\u0440 \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0442 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0443 handshake.</p> \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430 TCP \u0421\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0413\u0430\u0440\u0430\u043d\u0442\u0438\u044f \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0414\u0430 \u041f\u043e\u0440\u044f\u0434\u043e\u043a \u043f\u0430\u043a\u0435\u0442\u043e\u0432 \u0413\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u041d\u0438\u0436\u0435, \u0447\u0435\u043c \u0443 UDP \u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 HTTP, \u0447\u0430\u0442\u044b, \u0444\u0430\u0439\u043b\u044b"},{"location":"lr1/report/#4","title":"\u0412\u0430\u0440\u0438\u0430\u043d\u0442 4. \u041f\u043b\u043e\u0449\u0430\u0434\u044c \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430","text":"<p>\u0424\u043e\u0440\u043c\u0443\u043b\u0430: S = a \u00d7 h</p> <p>\u0413\u0434\u0435:</p> <ul> <li><code>a</code> \u2014 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430</li> <li><code>h</code> \u2014 \u0432\u044b\u0441\u043e\u0442\u0430</li> </ul>"},{"location":"lr1/report/#_11","title":"\u0424\u0430\u0439\u043b\u044b","text":"<ul> <li><code>part_2_tcp/tcp_server.py</code> \u2014 \u0441\u0435\u0440\u0432\u0435\u0440</li> <li><code>part_2_tcp/tcp_client.py</code> \u2014 \u043a\u043b\u0438\u0435\u043d\u0442</li> </ul>"},{"location":"lr1/report/#_12","title":"\u041b\u043e\u0433\u0438\u043a\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0430","text":"<ol> <li>\u0421\u043e\u0437\u0434\u0430\u0442\u044c TCP-\u0441\u043e\u043a\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 <code>socket.socket(AF_INET, SOCK_STREAM)</code></li> <li>\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044c \u043f\u0435\u0440\u0435\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0440\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 <code>setsockopt</code></li> <li>\u041f\u0440\u0438\u0432\u044f\u0437\u0430\u0442\u044c \u043a <code>localhost:12346</code> \u0447\u0435\u0440\u0435\u0437 <code>bind()</code></li> <li>\u041d\u0430\u0447\u0430\u0442\u044c \u0441\u043b\u0443\u0448\u0430\u0442\u044c \u0447\u0435\u0440\u0435\u0437 <code>listen(5)</code></li> <li>\u0412 \u0446\u0438\u043a\u043b\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0447\u0435\u0440\u0435\u0437 <code>accept()</code></li> <li>\u0414\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043a\u043b\u0438\u0435\u043d\u0442\u0430 \u0432\u044b\u0437\u0432\u0430\u0442\u044c <code>handle_client()</code>:<ul> <li>\u0427\u0438\u0442\u0430\u0442\u044c JSON-\u0437\u0430\u043f\u0440\u043e\u0441\u044b \u0447\u0435\u0440\u0435\u0437 <code>recv(1024)</code></li> <li>\u0420\u0430\u0437\u043e\u0431\u0440\u0430\u0442\u044c \u0447\u0435\u0440\u0435\u0437 <code>json.loads()</code></li> <li>\u0418\u0437\u0432\u043b\u0435\u0447\u044c <code>base</code> \u0438 <code>height</code></li> <li>\u0412\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u043f\u043e \u0444\u043e\u0440\u043c\u0443\u043b\u0435 <code>base * height</code></li> <li>\u0412\u0435\u0440\u043d\u0443\u0442\u044c JSON \u0441 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c</li> </ul> </li> <li>\u0412\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u044f: \u0435\u0441\u043b\u0438 <code>base &lt;= 0</code> \u0438\u043b\u0438 <code>height &lt;= 0</code> \u2014 \u0432\u0435\u0440\u043d\u0443\u0442\u044c \u043e\u0448\u0438\u0431\u043a\u0443</li> </ol>"},{"location":"lr1/report/#_13","title":"\u041b\u043e\u0433\u0438\u043a\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430","text":"<ol> <li>\u0421\u043e\u0437\u0434\u0430\u0442\u044c TCP-\u0441\u043e\u043a\u0435\u0442</li> <li>\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u044c\u0441\u044f \u0447\u0435\u0440\u0435\u0437 <code>connect()</code> \u043a \u0441\u0435\u0440\u0432\u0435\u0440\u0443</li> <li>\u0412 \u0446\u0438\u043a\u043b\u0435 \u0437\u0430\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044c \u0443 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0432\u044b\u0441\u043e\u0442\u0443</li> <li>\u0424\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c JSON-\u0437\u0430\u043f\u0440\u043e\u0441 \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0447\u0435\u0440\u0435\u0437 <code>send()</code></li> <li>\u0427\u0438\u0442\u0430\u0442\u044c \u043e\u0442\u0432\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 <code>recv(1024)</code>, \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044c <code>json.loads()</code></li> <li>\u0412\u044b\u0432\u043e\u0434\u0438\u0442\u044c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0438\u043b\u0438 \u043e\u0448\u0438\u0431\u043a\u0443</li> <li>\u0421\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044c \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435</li> </ol>"},{"location":"lr1/report/#_14","title":"\u041f\u0440\u0438\u043c\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u044b","text":""},{"location":"lr1/report/#3-html-http","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u0435 3. \u0420\u0430\u0437\u0434\u0430\u0447\u0430 HTML-\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u043f\u043e HTTP","text":""},{"location":"lr1/report/#_15","title":"\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435","text":"<p>\u0421\u0435\u0440\u0432\u0435\u0440 \u043e\u0442\u0434\u0430\u0451\u0442 HTML-\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0447\u0438\u0442\u0430\u0435\u0442 \u0438\u0437 \u0444\u0430\u0439\u043b\u0430 <code>index.html</code>. \u041e\u0442\u0432\u0435\u0442 \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0432\u0440\u0443\u0447\u043d\u0443\u044e \u0432 \u0444\u043e\u0440\u043c\u0430\u0442\u0435 HTTP.</p>"},{"location":"lr1/report/#http-","title":"\u0424\u043e\u0440\u043c\u0430\u0442 HTTP-\u043e\u0442\u0432\u0435\u0442\u0430","text":"<pre><code>HTTP/1.1 200 OK\nContent-Type: text/html; charset=utf-8\nContent-Length: 1234\nConnection: close\n\n&lt;!DOCTYPE html&gt;\n...\n</code></pre> <ul> <li>\u0421\u0442\u0440\u043e\u043a\u0430 \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u2014 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b, \u043a\u043e\u0434, \u043f\u0440\u0438\u0447\u0438\u043d\u0430</li> <li>\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u2014 \u043c\u0435\u0442\u0430\u0434\u0430\u043d\u043d\u044b\u0435 \u043e\u0442\u0432\u0435\u0442\u0430</li> <li>\u041f\u0443\u0441\u0442\u0430\u044f \u0441\u0442\u0440\u043e\u043a\u0430 \u2014 \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u044c \u043c\u0435\u0436\u0434\u0443 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0430\u043c\u0438 \u0438 \u0442\u0435\u043b\u043e\u043c</li> <li>\u0422\u0435\u043b\u043e \u2014 \u0441\u0430\u043c HTML</li> </ul>"},{"location":"lr1/report/#_16","title":"\u0424\u0430\u0439\u043b\u044b","text":"<ul> <li><code>part_3_http/http_server.py</code> \u2014 \u0441\u0435\u0440\u0432\u0435\u0440</li> <li><code>part_3_http/index.html</code> \u2014 HTML-\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430</li> </ul>"},{"location":"lr1/report/#_17","title":"\u041b\u043e\u0433\u0438\u043a\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0430","text":"<ol> <li>\u0421\u043e\u0437\u0434\u0430\u0442\u044c TCP-\u0441\u043e\u043a\u0435\u0442</li> <li>\u041f\u0440\u0438\u0432\u044f\u0437\u0430\u0442\u044c \u043a <code>localhost:8080</code></li> <li>\u041d\u0430\u0447\u0430\u0442\u044c \u0441\u043b\u0443\u0448\u0430\u0442\u044c</li> <li>\u0412 \u0446\u0438\u043a\u043b\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f</li> <li>\u0414\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043a\u043b\u0438\u0435\u043d\u0442\u0430:<ul> <li>\u041f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u0444\u0430\u0439\u043b <code>index.html</code> \u0447\u0435\u0440\u0435\u0437 \u0444\u0443\u043d\u043a\u0446\u0438\u044e <code>read_html_file()</code></li> <li>\u0421\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c HTTP-\u043e\u0442\u0432\u0435\u0442 \u043a\u0430\u043a f-\u0441\u0442\u0440\u043e\u043a\u0443:<ul> <li>\u0441\u0442\u0430\u0442\u0443\u0441\u043d\u0430\u044f \u0441\u0442\u0440\u043e\u043a\u0430 <code>HTTP/1.1 200 OK\\r\\n</code></li> <li>\u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 <code>Content-Type</code>, <code>Content-Length</code>, <code>Connection</code></li> <li>\u043f\u0443\u0441\u0442\u0430\u044f \u0441\u0442\u0440\u043e\u043a\u0430 <code>\\r\\n</code></li> <li>\u0442\u0435\u043b\u043e \u2014 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0435 HTML-\u0444\u0430\u0439\u043b\u0430</li> </ul> </li> <li>\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0447\u0435\u0440\u0435\u0437 <code>sendall()</code></li> <li>\u0417\u0430\u043a\u0440\u044b\u0442\u044c \u0441\u043e\u043a\u0435\u0442</li> </ul> </li> </ol>"},{"location":"lr1/report/#_18","title":"\u041b\u043e\u0433\u0438\u043a\u0430 \u0447\u0442\u0435\u043d\u0438\u044f \u0444\u0430\u0439\u043b\u0430","text":"<p>\u0424\u0443\u043d\u043a\u0446\u0438\u044f <code>read_html_file(filename)</code>:</p> <ul> <li>\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0444\u0430\u0439\u043b \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 <code>'r'</code> \u0441 \u043a\u043e\u0434\u0438\u0440\u043e\u0432\u043a\u043e\u0439 UTF-8</li> <li>\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0435 \u043a\u0430\u043a \u0441\u0442\u0440\u043e\u043a\u0443</li> <li>\u041f\u0440\u0438 <code>FileNotFoundError</code> \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 HTML \u0441 \u043e\u0448\u0438\u0431\u043a\u043e\u0439 404</li> </ul>"},{"location":"lr1/report/#_19","title":"\u041f\u0440\u0438\u043c\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u044b","text":""},{"location":"lr1/report/#4_1","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u0435 4. \u041c\u043d\u043e\u0433\u043e\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0447\u0430\u0442","text":""},{"location":"lr1/report/#_20","title":"\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435","text":"<p>\u0427\u0430\u0442 \u043d\u0430 TCP \u0441 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u043e\u0439 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e. \u041a\u0430\u0436\u0434\u044b\u0439 \u043a\u043b\u0438\u0435\u043d\u0442 \u043e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u043c \u043f\u043e\u0442\u043e\u043a\u0435.</p>"},{"location":"lr1/report/#_21","title":"\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438","text":"\u041a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f \u041d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 <code>threading.Thread</code> \u041e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0442\u043e\u043a \u043d\u0430 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043a\u043b\u0438\u0435\u043d\u0442\u0430 <code>threading.Lock</code> \u0417\u0430\u0449\u0438\u0442\u0430 \u043e\u0431\u0449\u0438\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u043e\u0442 \u0433\u043e\u043d\u043e\u043a <code>json</code> \u0424\u043e\u0440\u043c\u0430\u0442 \u043e\u0431\u043c\u0435\u043d\u0430 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f\u043c\u0438 <code>dict clients</code> \u0425\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0435 <code>{username: socket}</code>"},{"location":"lr1/report/#_22","title":"\u041c\u043e\u0434\u0435\u043b\u044c \u0434\u0430\u043d\u043d\u044b\u0445","text":"<pre><code>self.clients = {\n    '\u0410\u043b\u0438\u0441\u0430': &lt;socket1&gt;,\n    '\u0412\u0430\u043d\u044f': &lt;socket2&gt;,\n    '\u041f\u0435\u0442\u044f': &lt;socket3&gt;\n}\n</code></pre>"},{"location":"lr1/report/#_23","title":"\u0410\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0430","text":"<ul> <li>\u041a\u0430\u0436\u0434\u043e\u043c\u0443 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044e \u2014 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0442\u043e\u043a</li> <li>\u041e\u0431\u0449\u0438\u0439 \u0441\u043b\u043e\u0432\u0430\u0440\u044c <code>clients</code> \u0437\u0430\u0449\u0438\u0449\u0451\u043d <code>Lock</code></li> <li>\u0420\u0430\u0441\u0441\u044b\u043b\u043a\u0430 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439: \u0432\u0441\u0435\u043c, \u043a\u0440\u043e\u043c\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044f</li> <li>\u041b\u0438\u0447\u043d\u044b\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f: \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u043c\u0443 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044e</li> <li>\u041f\u0440\u0438 \u0432\u044b\u0445\u043e\u0434\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u0432\u0441\u0435 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435</li> </ul>"},{"location":"lr1/report/#_24","title":"\u0424\u0430\u0439\u043b\u044b","text":"<ul> <li><code>part_4_chat/chat_server.py</code> \u2014 \u0441\u0435\u0440\u0432\u0435\u0440</li> <li><code>part_4_chat/chat_client.py</code> \u2014 \u043a\u043b\u0438\u0435\u043d\u0442 (\u043e\u0434\u0438\u043d \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439)</li> </ul>"},{"location":"lr1/report/#chatserver","title":"\u041b\u043e\u0433\u0438\u043a\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0430 (\u043a\u043b\u0430\u0441\u0441 <code>ChatServer</code>)","text":"<ol> <li><code>__init__</code> \u2014 \u0445\u0440\u0430\u043d\u0438\u0442 <code>host</code>, <code>port</code>, \u0441\u043b\u043e\u0432\u0430\u0440\u044c <code>clients</code>, <code>Lock</code></li> <li><code>start</code> \u2014 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u0441\u043e\u043a\u0435\u0442, \u0432 \u0446\u0438\u043a\u043b\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f, \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0441\u043e\u0437\u0434\u0430\u0451\u0442 <code>threading.Thread</code> \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439 <code>handle_client</code></li> <li><code>handle_client</code>:<ul> <li>\u041f\u0435\u0440\u0432\u044b\u043c \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435\u043c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0438\u043c\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f</li> <li>\u041f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442, \u0437\u0430\u043d\u044f\u0442\u043e \u043b\u0438 \u0438\u043c\u044f (\u043f\u043e\u0434 <code>Lock</code>)</li> <li>\u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0432 <code>clients</code></li> <li>\u0420\u0430\u0441\u0441\u044b\u043b\u0430\u0435\u0442 \u0432\u0441\u0435\u043c \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435 \u043e \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0438</li> <li>\u0412 \u0446\u0438\u043a\u043b\u0435 \u0447\u0438\u0442\u0430\u0435\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043e\u0442 \u043a\u043b\u0438\u0435\u043d\u0442\u0430</li> <li>\u041e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u0442\u0438\u043f <code>message</code> (\u043e\u0431\u044b\u0447\u043d\u043e\u0435) \u0438 <code>private</code> (\u043b\u0438\u0447\u043d\u043e\u0435)</li> <li>\u041f\u0440\u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0443\u0434\u0430\u043b\u044f\u0435\u0442 \u0438\u0437 <code>clients</code> \u0438 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u044f\u0435\u0442 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0445</li> </ul> </li> <li><code>broadcast</code> \u2014 \u0440\u0430\u0441\u0441\u044b\u043b\u0430\u0435\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u043c, \u043a\u0440\u043e\u043c\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f</li> <li><code>send_private</code> \u2014 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u043c\u0443 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044e</li> </ol>"},{"location":"lr1/report/#chatclient","title":"\u041b\u043e\u0433\u0438\u043a\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430 (\u043a\u043b\u0430\u0441\u0441 <code>ChatClient</code>)","text":"<ol> <li><code>connect</code> \u2014 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u043a \u0441\u0435\u0440\u0432\u0435\u0440\u0443, \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0438\u043c\u044f, \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u043f\u043e\u0442\u043e\u043a <code>receive_messages</code></li> <li><code>receive_messages</code> \u2014 \u0432 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u043c \u043f\u043e\u0442\u043e\u043a\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043e\u0442 \u0441\u0435\u0440\u0432\u0435\u0440\u0430, \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 <code>display_message</code></li> <li><code>display_message</code> \u2014 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0442\u0438\u043f\u0430 (<code>system</code>, <code>message</code>, <code>private</code>, <code>error</code>) \u0432\u044b\u0432\u043e\u0434\u0438\u0442 \u0432 \u043a\u043e\u043d\u0441\u043e\u043b\u044c</li> <li><code>send_message</code> \u2014 \u043e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u043a\u043e\u043c\u0430\u043d\u0434\u044b (<code>/quit</code>, <code>/pm</code>, <code>/users</code>) \u0438 \u043e\u0431\u044b\u0447\u043d\u044b\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f, \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 JSON \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440</li> <li><code>run</code> \u2014 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0446\u0438\u043a\u043b: \u0447\u0438\u0442\u0430\u0435\u0442 <code>input()</code> \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0432 <code>send_message</code></li> </ol>"},{"location":"lr1/report/#_25","title":"\u041a\u043e\u043c\u0430\u043d\u0434\u044b \u043a\u043b\u0438\u0435\u043d\u0442\u0430","text":"\u041a\u043e\u043c\u0430\u043d\u0434\u0430 \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 <code>/users</code> \u0421\u043f\u0438\u0441\u043e\u043a \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043e\u043d\u043b\u0430\u0439\u043d <code>/pm &lt;\u0438\u043c\u044f&gt; &lt;\u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435&gt;</code> \u041b\u0438\u0447\u043d\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 <code>/quit</code> \u0412\u044b\u0445\u043e\u0434 \u0438\u0437 \u0447\u0430\u0442\u0430"},{"location":"lr1/report/#_26","title":"\u041f\u0440\u0438\u043c\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u044b","text":""},{"location":"lr1/report/#5-getpost","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u0435 5. \u0412\u0435\u0431-\u0441\u0435\u0440\u0432\u0435\u0440 \u0436\u0443\u0440\u043d\u0430\u043b\u0430 \u043e\u0446\u0435\u043d\u043e\u043a (GET/POST)","text":""},{"location":"lr1/report/#_27","title":"\u041f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0437\u0430\u0434\u0430\u0447\u0438","text":"<p>\u041d\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u0432\u0435\u0431-\u0441\u0435\u0440\u0432\u0435\u0440 \u043d\u0430 <code>socket</code>, \u043a\u043e\u0442\u043e\u0440\u044b\u0439:</p> <ol> <li>\u041f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0435 \u0438 \u043e\u0446\u0435\u043d\u043a\u0435</li> <li>\u041e\u0442\u0434\u0430\u0451\u0442 \u0432\u0441\u0435 \u043e\u0446\u0435\u043d\u043a\u0438 \u0432 \u0432\u0438\u0434\u0435 HTML-\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b</li> <li>\u0413\u0440\u0443\u043f\u043f\u0438\u0440\u0443\u0435\u0442 \u043e\u0446\u0435\u043d\u043a\u0438 \u043f\u043e \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0443</li> </ol>"},{"location":"lr1/report/#_28","title":"\u041c\u043e\u0434\u0435\u043b\u044c \u0434\u0430\u043d\u043d\u044b\u0445","text":"<p>\u041a\u043b\u044e\u0447\u0435\u0432\u043e\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435 \u2014 \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u043a\u0430 \u043f\u043e \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0443. \u0417\u043d\u0430\u0447\u0438\u0442, \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u0434\u0430\u043d\u043d\u044b\u0445 \u2014 \u0441\u043b\u043e\u0432\u0430\u0440\u044c \u0441\u043e \u0441\u043f\u0438\u0441\u043a\u0430\u043c\u0438:</p> <pre><code>self.grades = defaultdict(list)\n</code></pre>"},{"location":"lr1/report/#defaultdictlist-dict","title":"\u041f\u043e\u0447\u0435\u043c\u0443 <code>defaultdict(list)</code>, \u0430 \u043d\u0435 \u043e\u0431\u044b\u0447\u043d\u044b\u0439 dict","text":"<p>\u0411\u0435\u0437 defaultdict:</p> <pre><code>if discipline not in self.grades:\n    self.grades[discipline] = []\nself.grades[discipline].append(grade)\n</code></pre> <p>\u0421 defaultdict:</p> <pre><code>self.grades[discipline].append(grade)\n</code></pre>"},{"location":"lr1/report/#_29","title":"\u042d\u043d\u0434\u043f\u043e\u0438\u043d\u0442\u044b","text":"\u041c\u0435\u0442\u043e\u0434 URL \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 GET <code>/</code> \u0413\u043b\u0430\u0432\u043d\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0441 \u0444\u043e\u0440\u043c\u043e\u0439 GET <code>/grades</code> \u0416\u0443\u0440\u043d\u0430\u043b \u043e\u0446\u0435\u043d\u043e\u043a POST <code>/add_grade</code> \u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043e\u0446\u0435\u043d\u043a\u0443 GET <code>/static/style.css</code> CSS-\u0444\u0430\u0439\u043b GET <code>/favicon.ico</code> \u0418\u043a\u043e\u043d\u043a\u0430 \u0441\u0430\u0439\u0442\u0430 \u043b\u044e\u0431\u043e\u0439 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430 404"},{"location":"lr1/report/#_30","title":"\u0424\u0430\u0439\u043b\u044b","text":"<ul> <li><code>part_5_web_server/web_server.py</code> \u2014 \u0441\u0435\u0440\u0432\u0435\u0440</li> <li><code>part_5_web_server/templates/index.html</code> \u2014 \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0441 \u0444\u043e\u0440\u043c\u043e\u0439</li> <li><code>part_5_web_server/templates/grades.html</code> \u2014 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0436\u0443\u0440\u043d\u0430\u043b\u0430</li> <li><code>part_5_web_server/templates/404.html</code> \u2014 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043e\u0448\u0438\u0431\u043a\u0438</li> <li><code>part_5_web_server/static/style.css</code> \u2014 \u0441\u0442\u0438\u043b\u0438</li> </ul>"},{"location":"lr1/report/#myhttpserver","title":"\u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u043a\u043b\u0430\u0441\u0441\u0430 <code>MyHTTPServer</code>","text":"\u041c\u0435\u0442\u043e\u0434 \u041d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 <code>__init__</code> \u0425\u0440\u0430\u043d\u0438\u0442 host, port, name, <code>grades = defaultdict(list)</code> <code>serve_forever</code> \u0417\u0430\u043f\u0443\u0441\u043a \u0441\u0435\u0440\u0432\u0435\u0440\u0430, \u0446\u0438\u043a\u043b <code>accept()</code> <code>serve_client</code> \u041e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043e\u0434\u043d\u043e\u0433\u043e \u043a\u043b\u0438\u0435\u043d\u0442\u0430 <code>parse_request</code> \u0420\u0430\u0437\u0431\u043e\u0440 \u043f\u0435\u0440\u0432\u043e\u0439 \u0441\u0442\u0440\u043e\u043a\u0438 \u0437\u0430\u043f\u0440\u043e\u0441\u0430 <code>parse_headers</code> \u0420\u0430\u0437\u0431\u043e\u0440 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u043e\u0432 <code>handle_request</code> \u041c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u043e \u043c\u0435\u0442\u043e\u0434\u0443 \u0438 URL <code>send_response</code> \u0424\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0430 \u043e\u0442\u0432\u0435\u0442\u0430 <code>_load_template</code> \u0427\u0442\u0435\u043d\u0438\u0435 HTML-\u0448\u0430\u0431\u043b\u043e\u043d\u0430 \u0438\u0437 <code>templates/</code> <code>_serve_static</code> \u041e\u0442\u0434\u0430\u0447\u0430 CSS \u0438\u0437 <code>static/</code> <code>_handle_root</code> GET <code>/</code> \u2014 \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0441 \u0444\u043e\u0440\u043c\u043e\u0439 <code>_handle_add_grade</code> POST <code>/add_grade</code> \u2014 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0446\u0435\u043d\u043a\u0438 <code>_handle_grades</code> GET <code>/grades</code> \u2014 \u0436\u0443\u0440\u043d\u0430\u043b \u0441 \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u043a\u043e\u0439 <code>_handle_404</code> \u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430 404"},{"location":"lr1/report/#_31","title":"\u041a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0441\u0435\u0440\u0432\u0435\u0440","text":""},{"location":"lr1/report/#1_1","title":"1. \u0417\u0430\u043f\u0443\u0441\u043a","text":"<p><code>serve_forever</code> \u0441\u043e\u0437\u0434\u0430\u0451\u0442 TCP-\u0441\u043e\u043a\u0435\u0442, \u043f\u0440\u0438\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442 \u043a <code>localhost:8081</code>, \u0441\u043b\u0443\u0448\u0430\u0435\u0442. \u0412 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c \u0446\u0438\u043a\u043b\u0435 <code>accept()</code> \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432 \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0432 <code>serve_client</code>.</p>"},{"location":"lr1/report/#2","title":"2. \u041e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430","text":"<p><code>serve_client</code>:</p> <ul> <li>\u0421\u043e\u0437\u0434\u0430\u0451\u0442 file-like \u043e\u0431\u044a\u0435\u043a\u0442 \u0447\u0435\u0440\u0435\u0437 <code>makefile('rb')</code> \u2014 \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0447\u043d\u043e\u0433\u043e \u0447\u0442\u0435\u043d\u0438\u044f</li> <li>\u0412\u044b\u0437\u044b\u0432\u0430\u0435\u0442 <code>parse_request</code> \u2192 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 <code>method</code>, <code>url</code>, <code>params</code>, <code>protocol</code></li> <li>\u0412\u044b\u0437\u044b\u0432\u0430\u0435\u0442 <code>parse_headers</code> \u2192 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0441\u043b\u043e\u0432\u0430\u0440\u044c \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u043e\u0432</li> <li>\u0412\u044b\u0437\u044b\u0432\u0430\u0435\u0442 <code>handle_request</code> \u2192 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 <code>(status, reason, body)</code> \u0438\u043b\u0438 <code>(status, reason, body, content_type)</code></li> <li>\u0412\u044b\u0437\u044b\u0432\u0430\u0435\u0442 <code>send_response</code> \u2192 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 HTTP-\u043e\u0442\u0432\u0435\u0442</li> </ul>"},{"location":"lr1/report/#3","title":"3. \u0420\u0430\u0437\u0431\u043e\u0440 \u0437\u0430\u043f\u0440\u043e\u0441\u0430","text":"<p><code>parse_request</code>:</p> <ul> <li>\u0427\u0438\u0442\u0430\u0435\u0442 \u043f\u0435\u0440\u0432\u0443\u044e \u0441\u0442\u0440\u043e\u043a\u0443 \u0447\u0435\u0440\u0435\u0437 <code>readline()</code></li> <li>\u0420\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u0442 \u043f\u043e \u043f\u0440\u043e\u0431\u0435\u043b\u0430\u043c: <code>method</code>, <code>url</code>, <code>protocol</code></li> <li>\u0415\u0441\u043b\u0438 \u0432 URL \u0435\u0441\u0442\u044c <code>?</code> \u2014 \u0440\u0430\u0437\u0434\u0435\u043b\u044f\u0435\u0442 \u043d\u0430 \u043f\u0443\u0442\u044c \u0438 query-\u0441\u0442\u0440\u043e\u043a\u0443</li> <li>\u0420\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442 query-\u0441\u0442\u0440\u043e\u043a\u0443 \u0447\u0435\u0440\u0435\u0437 <code>urllib.parse.parse_qs()</code></li> </ul>"},{"location":"lr1/report/#4_2","title":"4. \u0420\u0430\u0437\u0431\u043e\u0440 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u043e\u0432","text":"<p><code>parse_headers</code>:</p> <ul> <li>\u0427\u0438\u0442\u0430\u0435\u0442 \u0441\u0442\u0440\u043e\u043a\u0438 \u0434\u043e \u043f\u0443\u0441\u0442\u043e\u0439</li> <li>\u041a\u0430\u0436\u0434\u0443\u044e \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442 \u043f\u043e <code>': '</code></li> <li>\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0441\u043b\u043e\u0432\u0430\u0440\u044c</li> </ul>"},{"location":"lr1/report/#5","title":"5. \u041c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u044f","text":"<p><code>handle_request</code>:</p> <ul> <li>\u0415\u0441\u043b\u0438 POST \u2014 \u0447\u0438\u0442\u0430\u0435\u0442 \u0442\u0435\u043b\u043e \u0447\u0435\u0440\u0435\u0437 <code>request_file.read(content_length)</code> (\u0434\u043b\u0438\u043d\u0430 \u0438\u0437 <code>Content-Length</code>)</li> <li>\u0420\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442 \u0442\u0435\u043b\u043e \u0447\u0435\u0440\u0435\u0437 <code>parse_qs</code> \u0438 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0432 <code>params</code></li> <li>\u0415\u0441\u043b\u0438 URL \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0441 <code>/static/</code> \u2014 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 <code>_serve_static</code></li> <li>\u0415\u0441\u043b\u0438 <code>/favicon.ico</code> \u2014 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 204</li> <li>\u0415\u0441\u043b\u0438 <code>GET /</code> \u2014 <code>_handle_root</code></li> <li>\u0415\u0441\u043b\u0438 <code>GET /grades</code> \u2014 <code>_handle_grades</code></li> <li>\u0415\u0441\u043b\u0438 <code>POST /add_grade</code> \u2014 <code>_handle_add_grade</code></li> <li>\u0418\u043d\u0430\u0447\u0435 \u2014 <code>_handle_404</code></li> </ul>"},{"location":"lr1/report/#6","title":"6. \u041e\u0442\u043f\u0440\u0430\u0432\u043a\u0430 \u043e\u0442\u0432\u0435\u0442\u0430","text":"<p><code>send_response</code>:</p> <ul> <li>\u041a\u043e\u0434\u0438\u0440\u0443\u0435\u0442 \u0442\u0435\u043b\u043e \u0432 \u0431\u0430\u0439\u0442\u044b</li> <li>\u0424\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438: \u0441\u0442\u0430\u0442\u0443\u0441\u043d\u0430\u044f \u0441\u0442\u0440\u043e\u043a\u0430, <code>Content-Type</code>, <code>Content-Length</code>, <code>Connection: close</code>, <code>Server</code></li> <li>\u041e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 <code>sendall()</code> \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438, \u043f\u043e\u0442\u043e\u043c \u0442\u0435\u043b\u043e</li> </ul>"},{"location":"lr1/report/#7","title":"7. \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0446\u0435\u043d\u043a\u0438","text":"<p><code>_handle_add_grade</code>:</p> <ul> <li>\u0418\u0437\u0432\u043b\u0435\u043a\u0430\u0435\u0442 <code>discipline</code> \u0438 <code>grade</code> \u0438\u0437 <code>params</code></li> <li>\u0412\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u044f: \u043d\u0435 \u043f\u0443\u0441\u0442\u043e, \u0447\u0438\u0441\u043b\u043e, 1\u20135</li> <li>\u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u0441\u0442\u0440\u043e\u043a\u0430: <code>self.grades[discipline].append(grade)</code> \u2014 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u0446\u0435\u043d\u043a\u0443 \u0432 \u0441\u043f\u0438\u0441\u043e\u043a \u0434\u043b\u044f \u0434\u0430\u043d\u043d\u043e\u0439 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b</li> <li>\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0433\u043b\u0430\u0432\u043d\u0443\u044e \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u0441 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435\u043c \u043e\u0431 \u0443\u0441\u043f\u0435\u0445\u0435</li> </ul>"},{"location":"lr1/report/#8","title":"8. \u0424\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0436\u0443\u0440\u043d\u0430\u043b\u0430","text":"<p><code>_handle_grades</code>:</p> <ul> <li>\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u0442 \u0448\u0430\u0431\u043b\u043e\u043d <code>grades.html</code></li> <li>\u0415\u0441\u043b\u0438 \u0436\u0443\u0440\u043d\u0430\u043b \u043f\u0443\u0441\u0442 \u2014 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u00ab\u041f\u043e\u043a\u0430 \u043d\u0435\u0442 \u043e\u0446\u0435\u043d\u043e\u043a\u00bb</li> <li>\u0418\u043d\u0430\u0447\u0435 \u0432 \u0446\u0438\u043a\u043b\u0435 <code>for discipline in sorted(self.grades.keys())</code>:<ul> <li>\u041f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0441\u043f\u0438\u0441\u043e\u043a \u043e\u0446\u0435\u043d\u043e\u043a \u0434\u043b\u044f \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b</li> <li>\u0421\u0447\u0438\u0442\u0430\u0435\u0442 \u0441\u0440\u0435\u0434\u043d\u044e\u044e \u0438 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e</li> <li>\u0424\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442 HTML-\u0431\u043b\u043e\u043a <code>&lt;div class=\"subject\"&gt;</code></li> <li>\u0412\u043d\u0443\u0442\u0440\u0438 \u2014 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b, \u043c\u0435\u0442\u043a\u0438 \u043e\u0446\u0435\u043d\u043e\u043a, \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430</li> </ul> </li> <li>\u041f\u043e\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0432 \u0448\u0430\u0431\u043b\u043e\u043d \u0447\u0435\u0440\u0435\u0437 <code>str.replace('{{GRADES}}', ...)</code> \u0438 <code>str.replace('{{TOTAL}}', ...)</code></li> <li>\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0433\u043e\u0442\u043e\u0432\u044b\u0439 HTML</li> </ul>"},{"location":"lr1/report/#9","title":"9. \u041e\u0442\u0434\u0430\u0447\u0430 \u0441\u0442\u0430\u0442\u0438\u043a\u0438","text":"<p><code>_serve_static</code>:</p> <ul> <li>\u0418\u0437\u0432\u043b\u0435\u043a\u0430\u0435\u0442 \u0438\u043c\u044f \u0444\u0430\u0439\u043b\u0430 \u0438\u0437 URL</li> <li>\u0417\u0430\u0449\u0438\u0442\u0430 \u043e\u0442 path traversal \u0447\u0435\u0440\u0435\u0437 <code>os.path.basename</code></li> <li>\u0427\u0438\u0442\u0430\u0435\u0442 \u0444\u0430\u0439\u043b \u0432 \u0431\u0430\u0439\u0442\u0430\u0445</li> <li>\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 <code>(200, \"OK\", content, 'text/css')</code></li> </ul>"},{"location":"lr1/report/#_32","title":"\u041a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0448\u0430\u0431\u043b\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u044f","text":"<p>\u0412 HTML-\u0448\u0430\u0431\u043b\u043e\u043d\u0430\u0445 \u0435\u0441\u0442\u044c \u043f\u043b\u0435\u0439\u0441\u0445\u043e\u043b\u0434\u0435\u0440\u044b:</p> <ul> <li><code>{{MESSAGE}}</code> \u2014 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043e\u0431 \u0443\u0441\u043f\u0435\u0445\u0435/\u043e\u0448\u0438\u0431\u043a\u0435</li> <li><code>{{GRADES}}</code> \u2014 HTML-\u0431\u043b\u043e\u043a \u0441 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u043c\u0438</li> <li><code>{{TOTAL}}</code> \u2014 \u0438\u0442\u043e\u0433\u043e\u0432\u0430\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430</li> </ul> <p>\u0412 Python \u043e\u043d\u0438 \u0437\u0430\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 <code>str.replace()</code>:</p> <pre><code>html = template.replace('{{GRADES}}', grades_html)\n</code></pre>"},{"location":"lr1/report/#_33","title":"\u041f\u0440\u0438\u043c\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u044b","text":""},{"location":"lr1/report/#_34","title":"\u0412\u044b\u0432\u043e\u0434","text":"<p>\u0412 \u0445\u043e\u0434\u0435 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u0441\u0432\u043e\u0435\u043d\u044b:</p> <ul> <li>\u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u043a\u043b\u0438\u0435\u043d\u0442-\u0441\u0435\u0440\u0432\u0435\u0440\u043d\u043e\u0433\u043e \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f</li> <li>\u0440\u0430\u0431\u043e\u0442\u0430 \u0441 \u0441\u043e\u043a\u0435\u0442\u0430\u043c\u0438 UDP \u0438 TCP</li> <li>\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 HTTP-\u043e\u0442\u0432\u0435\u0442\u043e\u0432 \u0432\u0440\u0443\u0447\u043d\u0443\u044e</li> <li>\u043c\u043d\u043e\u0433\u043e\u043f\u043e\u0442\u043e\u0447\u043d\u0430\u044f \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432 \u0447\u0435\u0440\u0435\u0437 <code>threading</code></li> </ul> <p>\u0412\u0441\u0435 \u043f\u044f\u0442\u044c \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u044b \u0438 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e.</p>"}]}